{
  "name": "caserito",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:backend dev:frontend",
    "dev:backend": "npm --workspace backend run dev",
    "dev:frontend": "npm --workspace frontend run dev",
    "build": "npm run build -w backend && npm run build -w frontend"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
