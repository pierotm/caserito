generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
}

enum UnitMeasure {
  UNIDAD
  KG
}

enum SaleStatus {
  COMPLETED
  VOIDED
}

model Store {
  id        String    @id @default(uuid())
  name      String
  createdAt DateTime  @default(now()) @map("created_at")
  users     User[]
  products  Product[]
  sales     Sale[]

  @@map("tiendas")
}

model User {
  id                   String   @id @default(uuid())
  storeId              String   @map("tienda_id")
  email                String   @unique
  passwordHash         String   @map("password_hash")
  role                 Role     @default(OWNER)
  requirePasswordReset Boolean  @default(true) @map("require_password_reset")
  createdAt            DateTime @default(now()) @map("created_at")
  store                Store    @relation(fields: [storeId], references: [id])

  @@map("usuarios")
}

model Product {
  id                String      @id @default(uuid())
  storeId           String      @map("tienda_id")
  name              String      @map("nombre")
  price             Decimal     @db.Decimal(12, 2) @map("precio")
  unitMeasure       UnitMeasure @map("unidad_medida")
  stock             Decimal     @db.Decimal(12, 3)
  isFrequent        Boolean     @default(false) @map("is_frecuente")
  packSize          Int?        @map("pack_size")
  lowStockThreshold Decimal     @db.Decimal(12, 3) @map("low_stock_threshold")
  isActive          Boolean     @default(true) @map("is_active")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")
  store             Store       @relation(fields: [storeId], references: [id])
  saleDetails       SaleDetail[]

  @@map("productos")
  @@index([storeId, isActive])
}

model Sale {
  id           String      @id @default(uuid())
  storeId      String      @map("tienda_id")
  clientSaleId String      @map("client_sale_id")
  total        Decimal     @db.Decimal(12, 2)
  date         DateTime    @default(now()) @map("fecha")
  status       SaleStatus  @default(COMPLETED)
  createdAt    DateTime    @default(now()) @map("created_at")
  store        Store       @relation(fields: [storeId], references: [id])
  details      SaleDetail[]

  @@map("ventas")
  @@unique([storeId, clientSaleId])
  @@index([storeId, date])
}

model SaleDetail {
  id                  String      @id @default(uuid())
  saleId              String      @map("venta_id")
  productId           String      @map("producto_id")
  unitMeasureSnapshot UnitMeasure @map("unidad_medida_snapshot")
  quantity            Decimal     @db.Decimal(12, 3) @map("cantidad")
  packApplied         Boolean     @default(false) @map("pack_aplicado")
  packSizeSnapshot    Int?        @map("pack_size_snapshot")
  unitPrice           Decimal     @db.Decimal(12, 2) @map("precio_unitario")
  subtotal            Decimal     @db.Decimal(12, 2)
  sale                Sale        @relation(fields: [saleId], references: [id])
  product             Product     @relation(fields: [productId], references: [id])

  @@map("venta_detalle")
  @@index([saleId])
}
